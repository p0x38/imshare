{
    "name": "imshare",
    "version": "1.4.2",
    "description": "Self-hosted image archive and sharing server",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --watch views --ext ts,tsx,ejs --exec \"tsx src/server.ts\"",
        "dev:client": "vite --host 0.0.0.0",
        "build": "pnpm prisma generate && pnpm build:client && tsc",
        "build:client": "tsc -p tsconfig.client.json && vite build",
        "start": "node --import ./dist/instrumentation.js dist/server.js",
        "openapi:export": "tsx src/export-openapi.ts",
        "db:generate": "pnpm prisma generate",
        "db:migrate": "pnpm prisma migrate dev",
        "db:validate": "pnpm prisma validate",
        "db:deploy": "pnpm prisma migrate deploy",
        "typecheck": "pnpm prisma generate && tsc --noEmit && tsc -p tsconfig.client.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "tsx test/run.ts",
        "test:browser": "pnpm build:client && playwright test",
        "test:browser:ui": "pnpm build:client && playwright test --ui",
        "test:browser:headed": "pnpm build:client && playwright test --headed",
        "test:coverage": "vitest run --coverage",
        "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:browser && pnpm build",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "migrate:uploads": "tsx src/tools/migrate-uploads.ts",
        "migrate:avatars": "tsx src/tools/migrate-avatars.ts",
        "migrate:images": "tsx src/tools/migrate-images.ts",
        "import:draft-images": "tsx src/tools/import-draft-images.ts",
        "migrate:cache": "tsx src/tools/migrate-cache.ts",
        "serve:unavailable": "tsx src/tools/serve-service-unavailable.ts",
        "cache:prune": "tsx src/tools/prune-cache.ts"
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=24"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.x",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@11.25.0",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@playwright/test": "^1.63.0",
        "@release-it/conventional-changelog": "^12.0.2",
        "@types/better-sqlite3": "^7.6.13",
        "@types/ejs": "^3.1.5",
        "@types/node": "^22.20.1",
        "@types/nodemailer": "^8.0.2",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@types/web-push": "^3.6.4",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^10.10.0",
        "nodemon": "^3.1.10",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "prisma": "7.10.0",
        "release-it": "^21.1.0",
        "tsx": "^4.23.13",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.42.0",
        "vite": "^7.1.12",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@better-auth/prisma-adapter": "^1.7.3",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.0",
        "@fastify/cookie": "^11.1.2",
        "@fastify/multipart": "^10.1.1",
        "@fastify/static": "^10.1.3",
        "@fastify/swagger": "^9.7.0",
        "@fastify/swagger-ui": "^5.0.1",
        "@fastify/view": "^12.0.0",
        "@mui/icons-material": "^7.3.4",
        "@mui/material": "^7.3.4",
        "@opentelemetry/api": "^1.9.1",
        "@opentelemetry/api-logs": "^0.222.0",
        "@opentelemetry/exporter-logs-otlp-grpc": "^0.222.0",
        "@opentelemetry/exporter-logs-otlp-proto": "^0.222.0",
        "@opentelemetry/exporter-metrics-otlp-grpc": "^0.222.0",
        "@opentelemetry/exporter-metrics-otlp-proto": "^0.222.0",
        "@opentelemetry/exporter-prometheus": "^0.222.0",
        "@opentelemetry/exporter-trace-otlp-grpc": "^0.222.0",
        "@opentelemetry/exporter-trace-otlp-proto": "^0.222.0",
        "@opentelemetry/instrumentation-http": "^0.222.0",
        "@opentelemetry/instrumentation-pino": "^0.68.0",
        "@opentelemetry/resources": "^2.11.0",
        "@opentelemetry/sdk-logs": "^0.222.0",
        "@opentelemetry/sdk-metrics": "^2.11.0",
        "@opentelemetry/sdk-node": "^0.222.0",
        "@opentelemetry/sdk-trace-base": "^2.11.0",
        "@prisma/adapter-better-sqlite3": "7.10.0",
        "@prisma/client": "7.10.0",
        "better-auth": "^1.7.3",
        "better-sqlite3": "13.0.3",
        "dotenv": "17.4.2",
        "ejs": "^6.0.1",
        "fastify": "^5.12.3",
        "fastify-plugin": "^5.0.1",
        "i18next": "^25.6.0",
        "nodemailer": "^10.0.10",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "react-i18next": "^16.0.1",
        "sharp": "^0.35.4",
        "socket.io": "^4.8.3",
        "thumbhash": "^0.1.1",
        "web-push": "^3.6.7",
        "zod": "^4.1.11",
        "zod-openapi": "^6.0.2"
    }
}
