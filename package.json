{
  "name": "imshare",
  "version": "1.0.0",
  "description": "Self-hosted image archive and sharing server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "pnpm prisma generate && tsc",
    "start": "node dist/server.js",
    "db:generate": "pnpm prisma generate",
    "db:migrate": "pnpm prisma migrate dev",
    "db:validate": "pnpm prisma validate",
    "typecheck": "pnpm prisma generate && tsc --noEmit",
    "lint": "eslint .",
    "test": "node --import tsx --test test/api.test.ts",
    "test:integration": "tsx test/run.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "engines": { "node": ">=24" },
  "devEngines": { "runtime": { "name": "node", "version": "24.x", "onFail": "download" } },
  "packageManager": "pnpm@12.3.4",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.20.1",
    "@types/better-sqlite3": "^7.6.13",
    "eslint": "^9.39.1",
    "prisma": "7.10.0",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.42.0"
  },
  "dependencies": {
    "@better-auth/prisma-adapter": "^1.7.3",
    "@fastify/cookie": "^11.1.2",
    "@fastify/multipart": "^10.1.1",
    "@fastify/static": "^10.1.3",
    "@prisma/adapter-better-sqlite3": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "^1.7.3",
    "better-sqlite3": "12.11.1",
    "dotenv": "17.4.2",
    "fastify": "^5.12.3",
    "sharp": "^0.35.4",
    "socket.io": "^4.8.3"
  }
}
