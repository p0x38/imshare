{
    "name": "imshare",
    "version": "1.0.0",
    "description": "Self-hosted image archive and sharing server",
    "main": "dist/server.js",
    "scripts": {
        "dev": "nodemon --watch src --watch views --ext ts,tsx,ejs --exec \"tsx src/server.ts\"",
        "dev:client": "vite --host 0.0.0.0",
        "build": "pnpm prisma generate && pnpm build:client && tsc",
        "build:client": "tsc -p tsconfig.client.json && vite build",
        "start": "node dist/server.js",
        "db:generate": "pnpm prisma generate",
        "db:migrate": "pnpm prisma migrate dev",
        "db:validate": "pnpm prisma validate",
        "typecheck": "pnpm prisma generate && tsc --noEmit && tsc -p tsconfig.client.json",
        "lint": "eslint .",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:integration": "tsx test/run.ts",
        "test:browser": "pnpm build:client && playwright test",
        "test:browser:ui": "pnpm build:client && playwright test --ui",
        "test:browser:headed": "pnpm build:client && playwright test --headed",
        "test:coverage": "vitest run --coverage",
        "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:integration && pnpm test:browser && pnpm build",
        "format": "prettier --write .",
        "format:check": "prettier --check ."
    },
    "keywords": [],
    "author": "",
    "license": "ISC",
    "engines": {
        "node": ">=24"
    },
    "devEngines": {
        "runtime": {
            "name": "node",
            "version": "24.x",
            "onFail": "download"
        }
    },
    "packageManager": "pnpm@11.25.0",
    "type": "module",
    "devDependencies": {
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.63.0",
        "@types/better-sqlite3": "^7.6.13",
        "@types/ejs": "^3.1.5",
        "@types/node": "^22.20.1",
        "@types/react": "^19.1.12",
        "@types/react-dom": "^19.1.9",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^5.0.0",
        "eslint": "^9.39.1",
        "nodemon": "^3.1.10",
        "pino-pretty": "^13.1.3",
        "prettier": "^3.9.6",
        "prisma": "7.10.0",
        "tsx": "^4.23.13",
        "typescript": "^7.0.2",
        "vitest": "^5.0.0"
    },
    "dependencies": {
        "@better-auth/prisma-adapter": "^1.7.3",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@fastify/cookie": "^11.1.2",
        "@fastify/multipart": "^10.1.1",
        "@fastify/static": "^10.1.3",
        "@fastify/swagger": "^9.7.0",
        "@fastify/swagger-ui": "^5.0.1",
        "@fastify/view": "^12.0.0",
        "@mui/icons-material": "^7.3.4",
        "@mui/material": "^7.3.4",
        "@prisma/adapter-better-sqlite3": "7.10.0",
        "@prisma/client": "7.10.0",
        "better-auth": "^1.7.3",
        "better-sqlite3": "12.11.1",
        "dotenv": "17.4.2",
        "ejs": "^6.0.1",
        "fastify": "^5.12.3",
        "fastify-plugin": "^5.0.1",
        "react": "^19.1.1",
        "react-dom": "^19.1.1",
        "sharp": "^0.35.4",
        "socket.io": "^4.8.3",
        "thumbhash": "^0.1.1"
    }
}
