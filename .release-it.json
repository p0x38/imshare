{
    "git": {
        "requireCleanWorkingDir": true,
        "requireBranch": "main",
        "commit": true,
        "commitMessage": "chore(release): bump v${version}",
        "tag": true,
        "tagName": "v${version}",
        "push": true
    },
    "npm": {
        "publish": false
    },
    "github": {
        "release": true
    },
    "plugins": {
        "@release-it/conventional-changelog": {
            "preset": {
                "name": "conventionalcommits"
            },
            "infile": "CHANGELOG.md"
        }
    }
}
