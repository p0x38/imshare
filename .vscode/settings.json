{
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "editor.formatOnSave": true,
    "editor.formatOnPaste": true,
    "editor.codeActionsOnSave": {
        "source.fixAll.eslint": "explicit"
    },
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.detectIndentation": false,
    "eslint.workingDirectories": [{ "mode": "location" }],
    "eslint.useFlatConfig": true,
    "files.exclude": {
        "**/.history": true,
        "**/dist": false,
        "**/node_modules": true,
        "**/uploads": false,
        "**/.env": false
    },
    "search.exclude": {
        "**/dist": true,
        "**/node_modules/**": true,
        "**/uploads": true,
        "**/.history": true,
        "**/.git/**": true,
        "**/dist/**": true,
        "**/coverage/**": true,
        "**/playwright-report/**": true,
        "**/test-results/**": true
    },
    "files.watcherExclude": {
        "**/.git/**": true,
        "**/node_modules/**": true,
        "**/dist/**": true,
        "**/coverage/**": true,
        "**/playwright-report/**": true,
        "**/test-results/**": true,
        "**/uploads/**": true,
        "**/.history/**": true
    },
    "js/ts.implicitProjectConfig.checkJs": false,
    "js/ts.tsserver.automaticTypeAcquisition.enabled": false,
    "js/ts.tsdk.path": "node_modules/typescript/lib",
    "npm.packageManager": "pnpm",
    "vitest.rootConfig": "./vitest.config.ts",
    "i18n-ally.localesPaths": ["src/client/locales"],
    "i18n-ally.sourceLanguage": "en",
    "i18n-ally.displayLanguage": "ja",
    "i18n-ally.keystyle": "nested",
    "i18n-ally.namespace": true,
    "i18n-ally.pathMatcher": "{locale}/{namespace}.json",
    "js/ts.tsserver.maxMemory": 4096,
    "js/ts.tsserver.experimental.enableProjectDiagnostics": false,
    "js/ts.preferences.includePackageJsonAutoImports": "off",
    "js/ts.suggest.autoImports": false,
    "i18n-ally.extract.ignoredByFiles": {
        "src\\client\\components\\ApiTokens.tsx": ["*"]
    },
    "i18n-ally.extract.autoDetect": false
}
