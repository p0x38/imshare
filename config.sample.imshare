# imshare native configuration
#
# Sizes support B, KB, MB, GB, KiB, MiB and GiB.
# Durations support ms, s, m, h and d.

server {
    host = "0.0.0.0"
    port = 5454
}

admin {
    local {
        enabled = true
        host = "127.0.0.1"
        port = 5107
    }
}

storage {
    uploadDirectory = "uploads"
    maxFileSize = 25MiB
}

site {
    name = "imshare"
    version = "1.0.0"
    description = "Self-hosted image archive and sharing server"
}

auth {
    # Public base URL. Set this to the URL users will access.
    baseUrl = "http://localhost:5454"

    # Additional browser origins allowed by Better Auth.
    trustedOrigins = []

    # Whether password authentication is available.
    emailAndPasswordEnabled = true

    # Append server.port to baseUrl when baseUrl does not already include a port.
    appendPort = true

    registration {
        enabled = true
        public = false

        # When true, new registrations wait for administrator approval
        # instead of requiring a registration token.
        manualApproval = false
    }
}

features {
    imagePosts = true
    textPosts = true
    comments = true
    reactions = true
    reports = true
    recommendations = true
    notifications = true
    search = true
    publicProfiles = true
    publicPosts = true
    apiDocs = true
    sitemap = true
    robots = true
}

limits {
    textPostCharacters = 500
}

analytics {
    # Optional Google Analytics 4 measurement ID.
    googleAnalyticsMeasurementId = ""

    # Optional Google Tag Manager container ID.
    googleTagManagerContainerId = ""
}

# Optional OpenTelemetry / Prometheus observability.
# Observability is completely disabled unless enabled = true.
#
# Metrics can be exported to Prometheus, OTLP, or both.
# Traces and logs can independently use OTLP gRPC or HTTP/protobuf.
federation {
    enabled = true
    incomingEnabled = true
    outgoingEnabled = true
    publicDiscovery = true
    sharedInboxEnabled = true
    deliveryTimeoutMs = 10000
    remoteFetchTimeoutMs = 10000
}

# P2P transport is reserved for a future peer-to-peer implementation.
# It is disabled by default.
p2p {
    enabled = false
    incomingEnabled = false
    outgoingEnabled = false
    discovery = "manual"
    signalingUrl = ""
    iceServers = []
}

observability {
    enabled = false

    serviceName = "imshare"
    serviceVersion = "1.0.0"
    environment = "development"
    instanceId = "main"

    batch {
        exportIntervalMs = 15000
        maxExportBatchSize = 512
        maxQueueSize = 2048
    }

    traces {
        enabled = false
        endpoint = "127.0.0.1:4317"
        protocol = "grpc"
        samplingRatio = 1.0
    }

    metrics {
        enabled = false
        exportIntervalMs = 15000

        prometheus {
            enabled = false
            path = "/metrics"
        }

        otlp {
            enabled = false
            endpoint = "127.0.0.1:4319"
            protocol = "grpc"
        }
    }

    logs {
        enabled = false
        includeTraceContext = true

        otlp {
            enabled = false
            endpoint = "http://127.0.0.1:4318/v1/logs"
            protocol = "http/protobuf"
        }
    }
}
