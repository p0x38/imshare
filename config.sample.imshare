# imshare native configuration
#
# Sizes support B, KB, MB, GB, KiB, MiB and GiB.
# Durations support ms, s, m, h and d.

server {
    host = "0.0.0.0"
    port = 5454
}

storage {
    uploadDirectory = "uploads"
    maxFileSize = 25MiB
}

site {
    name = "imshare"
    version = "1.0.0"
    description = "Self-hosted image archive and sharing server"
}

auth {
    baseUrl = "http://localhost:5454"
    trustedOrigins = []
    emailAndPasswordEnabled = true

    registration {
        enabled = true
        public = false
    }
}

features {
    imagePosts = true
    textPosts = true
    comments = true
    reactions = true
    reports = true
    recommendations = true
    notifications = true
    search = true
    publicProfiles = true
    publicPosts = true
    apiDocs = true
    sitemap = true
    robots = true
}

limits {
    textPostCharacters = 500
}

analytics {
    googleAnalyticsMeasurementId = ""
    googleTagManagerContainerId = ""
}
\n# Optional server observability\n# Metrics collection is disabled unless observability.enabled is true.\nobservability {\n    enabled = false\n\n    prometheus {\n        enabled = false\n        path = "/metrics"\n    }\n\n    openTelemetry {\n        enabled = false\n        endpoint = ""\n        exportIntervalMs = 10000\n    }\n}\n