<%- include("../partials/head", { title: "Dashboard · imshare" }) %>
<%- include("../partials/header") %>
<main>
    <div id="dashboard-page"></div>
</main>
<%- include("../partials/footer") %>
<script type="module">
const { api, showSnackbar } = window.imshareUI;
const root = document.querySelector("#dashboard-page");

function renderDashboard(user) {
    root.innerHTML = `
        <div class="box">
            <h1>Dashboard</h1>
            <p>Welcome back, <strong>${window.imshareUI.escapeHtml(user.name || user.email || "user")}</strong>.</p>
            <p>
                <a class="button" href="/dashboard/posts/">My posts</a>
                <a class="button" href="/dashboard/posts/new/">New post</a>
            </p>
        </div>
        <div class="grid">
            <section class="card">
                <h2>Content</h2>
                <p><a href="/dashboard/posts/">Manage posts</a></p>
                <p><a href="/dashboard/tags/">Manage tags</a></p>
                <p><a href="/dashboard/categories/">Manage categories</a></p>
            </section>
            <section class="card">
                <h2>Account</h2>
                <p><a href="/account/">Edit your profile</a></p>
                <p><a href="/account/logout/">Log out</a></p>
            </section>
        </div>`;
}

try {
    const response = await api("/v1/me");
    renderDashboard(response.data);
} catch (error) {
    showSnackbar(error instanceof Error ? error.message : "Unable to load your dashboard.", "error");
    location.href = "/account/login/";
}
</script>