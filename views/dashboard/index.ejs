<%- include("partials/head", { title: "Dashboard · imshare" }) %>
<%- include("partials/header") %>
<main><h1>Dashboard</h1><div id="content" class="box">Loading…</div></main>
<%- include("partials/footer") %>
<script type="module">
const content=document.querySelector("#content");try{const response=await fetch("/v1/me");if(response.status===401)location.href="/account/login/";else if(!response.ok)throw new Error();const{data}=await response.json();content.innerHTML=`<h2>Welcome, <span id="name"></span></h2><p><a class="button" href="/dashboard/posts/">My posts</a> <a class="button" href="/dashboard/posts/new/">New post</a></p><p><a href="/dashboard/tags/">Manage tags</a> · <a href="/dashboard/categories/">Manage categories</a> · <a href="/account/">Account</a></p>`;document.querySelector("#name").textContent=data.name||data.email||"user"}catch{content.textContent="Unable to load your dashboard."}
</script>