<%- include("../../partials/head", { title: "My Posts · imshare" }) %>
<%- include("../../partials/header") %>
<main>
    <div id="posts-page"></div>
</main>
<%- include("../../partials/footer") %>
<script type="module">
const { PostGrid, SkeletonGrid, mount, render } = window.imshareMUI;
const { api, showSnackbar } = window.imshareUI;
const root = document.querySelector("#posts-page");
const gridRoot = mount(root, SkeletonGrid({ count: 8 }));

try {
    const response = await api("/v1/me/posts?limit=100");
    const data = response.data ?? [];
    root.insertAdjacentHTML("afterbegin", `<h1>My Posts</h1><p><a class="button" href="/dashboard/posts/new/">New post</a></p><p class="meta">${data.length} post(s)</p>`);
    render(gridRoot, PostGrid({ posts: data, empty: data.length === 0, title: "You have not created any posts yet" }));
} catch (error) {
    if (error?.status === 401) {
        location.href = "/account/login/";
    } else {
        showSnackbar(error instanceof Error ? error.message : "Unable to load your posts.", "error");
        render(gridRoot, PostGrid({ posts: [], error: true }));
    }
}
</script>