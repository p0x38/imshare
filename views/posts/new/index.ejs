<%- include("../../partials/head", { title: "New Post · imshare" }) %>
<script src="/socket.io/socket.io.js"></script>
<%- include("../../partials/header") %>
<main>
    <h1>New Post</h1>
    <form id="post-form" class="box">
        <label for="title">Title</label>
        <input id="title" required maxlength="200" />
        <label for="caption">Image caption</label>
        <textarea id="caption" maxlength="10000"></textarea>
        <label for="description">Description</label>
        <textarea id="description"></textarea>
        <label for="file">Images</label>
        <input id="file" type="file" accept="image/*" multiple required />
        <div id="drop-zone" class="box" tabindex="0">Drop images here or use the file picker above.</div>
        <div id="previews" class="grid"></div>
        <progress id="upload-progress" max="100" value="0" hidden></progress>
        <p id="upload-status" class="meta" hidden></p>
        <button type="button" id="cancel" hidden>Cancel upload</button>
        <label for="sourceUrl">Source URL</label>
        <input id="sourceUrl" type="url" />
        <label><input id="allowDownload" type="checkbox" checked /> Allow visitors to download the original image</label>
        <label for="tags">Tags</label>
        <input id="tags" />
        <label for="category">Category</label>
        <select id="category"><option value="">None</option></select>
        <button id="submit">Create Post</button>
        <p id="error" class="error" hidden></p>
    </form>
</main>
<%- include("../../partials/footer") %>
<script type="module">
    const form = document.querySelector("#post-form");
    const fileInput = document.querySelector("#file");
    const dropZone = document.querySelector("#drop-zone");
    const previews = document.querySelector("#previews");
    const error = document.querySelector("#error");
    const button = document.querySelector("#submit");
    const category = document.querySelector("#category");
    const progress = document.querySelector("#upload-progress");
    const status = document.querySelector("#upload-status");
    const cancel = document.querySelector("#cancel");
    let xhr;
    let queuedFiles = [];
    const socket = window.io?.();
    const uploadStatuses = new Map();

    function setFiles(files) {
        queuedFiles = [...files].filter(file => file.type.startsWith("image/"));
        renderQueue();
        const transfer = new DataTransfer();
        for (const file of queuedFiles) transfer.items.add(file);
        fileInput.files = transfer.files;
    }

    function renderQueue() {
        previews.replaceChildren();
        queuedFiles.forEach((file, index) => {
            const card = document.createElement("article");
            card.className = "card";
            const img = document.createElement("img");
            img.className = "post-image";
            img.alt = file.name;
            img.src = URL.createObjectURL(file);
            img.onload = () => URL.revokeObjectURL(img.src);
            const label = document.createElement("p");
            label.className = "meta";
            label.textContent = `${index + 1}. ${file.name}`;
            const moveUp = document.createElement("button");
            moveUp.type = "button";
            moveUp.textContent = "↑";
            moveUp.disabled = index === 0;
            moveUp.onclick = () => {
                [queuedFiles[index - 1], queuedFiles[index]] = [queuedFiles[index], queuedFiles[index - 1]];
                renderQueue();
            };
            const moveDown = document.createElement("button");
            moveDown.type = "button";
            moveDown.textContent = "↓";
            moveDown.disabled = index === queuedFiles.length - 1;
            moveDown.onclick = () => {
                [queuedFiles[index], queuedFiles[index + 1]] = [queuedFiles[index + 1], queuedFiles[index]];
                renderQueue();
            };
            const remove = document.createElement("button");
            remove.type = "button";
            remove.textContent = "Remove";
            remove.onclick = () => {
                queuedFiles.splice(index, 1);
                renderQueue();
            };
            card.append(img, label, moveUp, moveDown, remove);
            previews.append(card);
        });
    }

    fileInput.addEventListener("change", () => setFiles(fileInput.files));
    ["dragenter", "dragover"].forEach(type => dropZone.addEventListener(type, event => {
        event.preventDefault();
        dropZone.setAttribute("data-dragging", "true");
    }));
    ["dragleave", "drop"].forEach(type => dropZone.addEventListener(type, event => {
        event.preventDefault();
        dropZone.removeAttribute("data-dragging");
    }));
    dropZone.addEventListener("drop", event => setFiles(event.dataTransfer.files));
    dropZone.addEventListener("keydown", event => {
        if (event.key === "Enter" || event.key === " ") fileInput.click();
    });

    (async () => {
        try {
            const r = await fetch("/v1/categories?limit=100");
            if (r.ok) {
                for (const item of (await r.json()).data || []) {
                    const option = document.createElement("option");
                    option.value = item.id;
                    option.textContent = item.name;
                    category.append(option);
                }
            }
        } catch {}
    })();

    if (socket) socket.on("upload:status", event => {
        uploadStatuses.set(event.uploadId, event);
        const states = [...uploadStatuses.values()];
        const done = states.filter(x => x.status === "ready").length;
        const failed = states.filter(x => x.status === "failed" || x.status === "cancelled").length;
        status.hidden = false;
        status.textContent = failed
            ? `${failed} upload${failed === 1 ? "" : "s"} failed`
            : done === states.length && states.length
                ? "All uploads ready"
                : `Processing ${done}/${states.length} images…`;
    });

    function upload(file) {
        return new Promise((resolve, reject) => {
            xhr = new XMLHttpRequest();
            xhr.open("POST", "/v1/uploads");
            cancel.hidden = false;
            xhr.upload.onprogress = event => {
                if (event.lengthComputable) {
                    progress.hidden = false;
                    progress.value = event.loaded / event.total * 100;
                    status.hidden = false;
                    status.textContent = `Uploading ${file.name}… ${Math.round(progress.value)}%`;
                }
            };
            xhr.onload = () => {
                cancel.hidden = true;
                if (xhr.status >= 200 && xhr.status < 300) {
                    resolve(JSON.parse(xhr.responseText).data);
                } else {
                    reject(new Error(xhr.status === 429 ? "Upload rate limit exceeded." : "Image upload failed."));
                }
            };
            xhr.onerror = () => {
                cancel.hidden = true;
                reject(new Error("Image upload failed."));
            };
            xhr.onabort = () => {
                cancel.hidden = true;
                reject(new Error("Upload cancelled."));
            };
            const data = new FormData();
            data.append("file", file);
            xhr.send(data);
        });
    }

    cancel.onclick = () => xhr?.abort();

    form.addEventListener("submit", async event => {
        event.preventDefault();
        error.hidden = true;
        button.disabled = true;
        button.textContent = "Creating…";
        try {
            if (!queuedFiles.length) throw new Error("Please choose at least one image.");
            const uploads = [];
            for (const file of queuedFiles) uploads.push(await upload(file));
            const tags = document.querySelector("#tags").value.split(",").map(x => x.trim()).filter(Boolean);
            const response = await fetch("/v1/posts", {
                method: "POST",
                headers: { "content-type": "application/json" },
                body: JSON.stringify({
                    title: document.querySelector("#title").value,
                    caption: document.querySelector("#caption").value || null,
                    description: document.querySelector("#description").value || null,
                    sourceUrl: document.querySelector("#sourceUrl").value || null,
                    allowDownload: document.querySelector("#allowDownload").checked,
                    uploadIds: uploads.map(upload => upload.id),
                    tags,
                    categoryId: category.value || null,
                }),
            });
            if (!response.ok) throw new Error("Post creation failed.");
            location.href = "/posts/" + encodeURIComponent((await response.json()).data.id);
        } catch (err) {
            error.textContent = err instanceof Error ? err.message : "Unable to create post.";
            error.hidden = false;
            button.disabled = false;
            button.textContent = "Create Post";
        }
    });
</script>