<!doctype html>
<html lang="en">
<head>
    <%- include("../partials/head", { title: "Account · imshare" }) %>
</head>
<body>
    <%- include("../partials/header") %>
    <main>
        <div id="account-page"></div>
    </main>
    <%- include("../partials/footer") %>
    <script type="module">
        const { api, showSnackbar, escapeHtml } = window.imshareUI;
        const content = document.querySelector("#account-page");

        function renderSignedOut() {
            content.innerHTML = `<div class="box"><h1>Account</h1><p>You are not signed in.</p><p><a class="button" href="/account/login/">Log in</a> <a class="button" href="/account/register/">Create account</a></p></div>`;
        }

        async function loadAccount() {
            try {
                const { data: user } = await api("/v1/me");
                if (!user) {
                    renderSignedOut();
                    return;
                }

                content.innerHTML = `
                    <h1>Account</h1>
                    <div class="profile box">
                        <img class="avatar" src="${escapeHtml(user.avatarUrl)}" alt="" loading="lazy" decoding="async" />
                        <div>
                            <h2>${escapeHtml(user.name || "Account")}</h2>
                            <p class="meta">${escapeHtml(user.email || "")}</p>
                        </div>
                    </div>
                    <form id="profile-form" class="box">
                        <h2>Profile</h2>
                        <label for="name">Name</label>
                        <input id="name" value="${escapeHtml(user.name || "")}" maxlength="100" required />
                        <label for="bio">Profile description</label>
                        <textarea id="bio" maxlength="2000">${escapeHtml(user.bio || "")}</textarea>
                        <label for="avatarMode">Profile avatar</label>
                        <select id="avatarMode">
                            <option value="initials">Text / initials</option>
                            <option value="default">Default</option>
                            <option value="identicon">Identicon</option>
                            <option value="gravatar">Gravatar</option>
                            <option value="custom">Custom URL or uploaded image ID</option>
                        </select>
                        <label for="avatarValue">Custom avatar value</label>
                        <input id="avatarValue" value="${escapeHtml(user.avatarValue || "")}" maxlength="2048" />
                        <label for="websiteUrl">Website</label>
                        <input id="websiteUrl" type="url" value="${escapeHtml(user.websiteUrl || "")}" maxlength="2048" />
                        <label for="githubUrl">GitHub</label>
                        <input id="githubUrl" type="url" value="${escapeHtml(user.githubUrl || "")}" maxlength="2048" />
                        <button type="submit">Save profile</button>
                    </form>
                    <section class="box">
                        <h2>Profile links</h2>
                        <ul id="links">${(user.profileLinks ?? []).map(link => `<li data-link="${escapeHtml(link.id)}"><a href="${escapeHtml(link.url)}" rel="noopener noreferrer nofollow">${escapeHtml(link.label)}</a> <button type="button" data-delete-link="${escapeHtml(link.id)}">Remove</button></li>`).join("") || "<li>No extra links yet.</li>"}</ul>
                        <form id="link-form">
                            <label for="link-label">Label</label>
                            <input id="link-label" maxlength="100" required />
                            <label for="link-url">URL</label>
                            <input id="link-url" type="url" maxlength="2048" required />
                            <button type="submit">Add link</button>
                        </form>
                    </section>
                    <p><a class="button" href="/dashboard/">Dashboard</a> <a class="button" href="/account/logout/">Log out</a></p>`;

                document.querySelector("#avatarMode").value = user.avatarMode || "initials";
                document.querySelector("#profile-form").addEventListener("submit", async event => {
                    event.preventDefault();
                    try {
                        await api(`/v1/users/${encodeURIComponent(user.id)}`, {
                            method: "PATCH",
                            body: JSON.stringify({
                                name: document.querySelector("#name").value,
                                bio: document.querySelector("#bio").value || null,
                                websiteUrl: document.querySelector("#websiteUrl").value || null,
                                githubUrl: document.querySelector("#githubUrl").value || null,
                                avatarMode: document.querySelector("#avatarMode").value,
                                avatarValue: document.querySelector("#avatarValue").value || null,
                            }),
                        });
                        showSnackbar("Profile saved.", "success");
                        await loadAccount();
                    } catch (error) {
                        showSnackbar(error instanceof Error ? error.message : "Unable to save profile.", "error");
                    }
                });

                document.querySelector("#link-form").addEventListener("submit", async event => {
                    event.preventDefault();
                    try {
                        await api("/v1/me/links", {
                            method: "POST",
                            body: JSON.stringify({
                                label: document.querySelector("#link-label").value,
                                url: document.querySelector("#link-url").value,
                            }),
                        });
                        showSnackbar("Profile link added.", "success");
                        await loadAccount();
                    } catch (error) {
                        showSnackbar(error instanceof Error ? error.message : "Unable to add profile link.", "error");
                    }
                });

                document.querySelector("#links").addEventListener("click", async event => {
                    const button = event.target.closest("[data-delete-link]");
                    if (!button) return;
                    if (!confirm("Remove this profile link?")) return;
                    try {
                        await api(`/v1/me/links/${encodeURIComponent(button.dataset.deleteLink)}`, { method: "DELETE" });
                        showSnackbar("Profile link removed.", "success");
                        await loadAccount();
                    } catch (error) {
                        showSnackbar(error instanceof Error ? error.message : "Unable to remove profile link.", "error");
                    }
                });
            } catch (error) {
                showSnackbar(error instanceof Error ? error.message : "Unable to load account information.", "error");
                renderSignedOut();
            }
        }

        await loadAccount();
    </script>
</body>
</html>
