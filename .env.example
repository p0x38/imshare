# Database
DATABASE_URL="file:./dev.db"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# Optional OpenID Connect / OAuth provider
# The discovery document should advertise the provider's authorization,
# token, userinfo, and (when applicable) JWKS endpoints.
OIDC_PROVIDER_ID="oidc"
OIDC_CLIENT_ID="replace-with-client-id"
OIDC_CLIENT_SECRET="replace-with-client-secret"
OIDC_DISCOVERY_URL="https://issuer.example.com/.well-known/openid-configuration"
