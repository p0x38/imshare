# Database
# SQLite is the default. To switch, replace both active values below with the PostgreSQL examples.
DATABASE_PROVIDER="sqlite"
DATABASE_URL="file:./dev.db"
# DATABASE_PROVIDER="postgresql"
# DATABASE_URL="postgresql://<user>:<password>@<host>:5432/<database>?schema=public"

# Better Auth
BETTER_AUTH_SECRET="replace-with-a-long-random-secret"

# SMTP / Mail (optional)
# Port 587 = STARTTLS
# Port 465 = implicit TLS
# Port 2525 = alternative SMTP submission
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="replace-with-smtp-username"
SMTP_PASSWORD="replace-with-smtp-password"
SMTP_FROM="imshare <noreply@example.com>"

# Web Push (optional)
# Generate a VAPID key pair with: pnpm exec web-push generate-vapid-keys
VAPID_PUBLIC_KEY="replace-with-vapid-public-key"
VAPID_PRIVATE_KEY="replace-with-vapid-private-key"
VAPID_SUBJECT="mailto:admin@example.com"

# Optional Meilisearch. Leave both unset to use SQLite FTS5.
# Rebuild the public-post index after enabling with: pnpm search:reindex
# Keep the API key server-side; never expose it to the browser.
# MEILISEARCH_URL="http://127.0.0.1:7700"
# MEILISEARCH_API_KEY="replace-with-meilisearch-key"
# MEILISEARCH_INDEX_UID="imshare_posts"

# Optional OpenID Connect / OAuth provider
# The discovery document should advertise the provider's authorization,
# token, userinfo, and (when applicable) JWKS endpoints.
OIDC_PROVIDER_ID="oidc"
OIDC_CLIENT_ID="replace-with-client-id"
OIDC_CLIENT_SECRET="replace-with-client-secret"
OIDC_DISCOVERY_URL="https://issuer.example.com/.well-known/openid-configuration"
